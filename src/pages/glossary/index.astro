---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getGlossary, kanaRow, KANA_ROWS } from '../../lib/content';
import { url } from '../../lib/url';

const terms = await getGlossary();
const groups = KANA_ROWS.map((row) => ({ row, items: terms.filter((t) => kanaRow(t.data.reading) === row) })).filter((g) => g.items.length);
---
<BaseLayout title="AI用語集" description="AIの分からない言葉を、初心者向けの一言説明つきで調べられます。">
  <PageHero title="AI用語集" eyebrow="09 🔤" description="分からない言葉を、初心者向けの「一言説明」つきでまとめています。" />
  <section class="section container">
    <div class="tools-bar">
      <label class="visually-hidden" for="g-filter">用語をしぼりこむ</label>
      <input id="g-filter" type="search" placeholder="用語をしぼりこむ（例：LLM、ぷろんぷと）" autocomplete="off" />
      <nav class="kana" aria-label="あいうえお順">
        {KANA_ROWS.map((r) => groups.some((g) => g.row === r) ? <a href={`#row-${r}`}>{r}</a> : <span>{r}</span>)}
      </nav>
    </div>
    {groups.map((g) => (
      <section class="row" id={`row-${g.row}`} data-row>
        <h2>{g.row === '英数' ? '英数字' : `${g.row}行`}</h2>
        <div class="grid">
          {g.items.map((t) => (
            <a class="card term" href={url(`/glossary/${t.id}/`)} data-text={`${t.data.term} ${t.data.reading} ${t.data.english ?? ''} ${t.data.short} ${t.data.tags.join(' ')}`.toLowerCase()}>
              <h3>{t.data.term}{t.data.english && <small>{t.data.english}</small>}</h3>
              <p class="reading">{t.data.reading}</p>
              <p>{t.data.short}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="empty" id="g-empty" hidden>見つかりませんでした。<a href={url('/search/')}>サイト内検索</a>も試してみてください。</p>
    {terms.length === 0 && <p class="empty">まだ用語がありません。</p>}
  </section>
</BaseLayout>
<script>
  const input = document.getElementById('g-filter') as HTMLInputElement | null;
  const empty = document.getElementById('g-empty');
  const toHira = (s: string) => s.replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
  input?.addEventListener('input', () => {
    const q = toHira(input.value.trim().toLowerCase());
    let total = 0;
    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      let n = 0;
      row.querySelectorAll<HTMLElement>('.term').forEach((card) => {
        const hit = !q || toHira(card.dataset.text ?? '').includes(q);
        card.hidden = !hit;
        if (hit) n++;
      });
      row.hidden = n === 0;
      total += n;
    });
    if (empty) empty.hidden = total > 0;
  });
</script>
<style>
  .tools-bar { display: flex; flex-direction: column; gap: 12px; margin-bottom: 8px; }
  input[type='search'] { width: 100%; max-width: 520px; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 1rem; font-family: inherit; background: #fff; }
  .kana { display: flex; flex-wrap: wrap; gap: 6px; }
  .kana a, .kana span { display: grid; place-items: center; min-width: 40px; height: 36px; padding: 0 8px; border-radius: 10px; font-weight: 700; font-family: var(--font-round); }
  .kana a { background: #fff; border: 1px solid #bfdbfe; }
  .kana span { color: #cbd5e1; }
  .row { margin-top: 28px; scroll-margin-top: 80px; }
  .row h2 { font-size: 1.15rem; border-bottom: 2px solid #dbeafe; padding-bottom: 4px; }
  .term h3 { margin: 0; font-size: 1.1rem; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .term small { font-size: 0.75rem; color: var(--muted); font-weight: 500; }
  .reading { margin: 0 0 6px; font-size: 0.75rem; color: var(--muted); }
  .term p:last-child { margin: 0; font-size: 0.9rem; color: #334155; }
  [hidden] { display: none !important; }
</style>
