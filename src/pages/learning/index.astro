---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getLearningLogs, formatDate } from '../../lib/content';
import { url } from '../../lib/url';

const logs = await getLearningLogs();
const latestDay = logs[0]?.data.day ?? 0;
const GOAL = 365;
---
<BaseLayout title="学習ログ" description="Day 1 から始まる、AI初心者の毎日の学習記録です。">
  <PageHero title="学習ログ" eyebrow="10 📒" description="Day 1 から始まる、AI初心者の毎日の学習記録。分かったことも、分からなかったことも、そのまま残しています。">
    <div class="progress" aria-label={`Day ${latestDay} / Day ${GOAL}`}>
      <div class="bar"><span style={`width:${Math.min(100, (latestDay / GOAL) * 100)}%`}></span></div>
      <p>いま <strong>Day {latestDay}</strong>（目標：Day {GOAL}）・記録 {logs.length} 件</p>
    </div>
  </PageHero>
  <section class="section container">
    {logs.length ? (
      <ol class="timeline">
        {logs.map((l) => (
          <li>
            <a class="card log" href={url(`/learning/${l.id}/`)}>
              <span class="day">Day<strong>{l.data.day}</strong></span>
              <div>
                <time datetime={l.data.date.toISOString()}>{formatDate(l.data.date)}</time>
                <span class="badge badge-teal">{l.data.category}</span>
                <h2>{l.data.title}</h2>
                {l.data.summary && <p>{l.data.summary}</p>}
                {l.data.participants.length > 0 && <small>参加者：{l.data.participants.join('、')}</small>}
              </div>
            </a>
          </li>
        ))}
      </ol>
    ) : <p class="empty">まだ学習ログがありません。</p>}
  </section>
</BaseLayout>
<style>
  .progress { margin-top: 18px; max-width: 520px; position: relative; z-index: 1; }
  .bar { height: 10px; border-radius: 999px; background: rgba(255,255,255,.15); overflow: hidden; }
  .bar span { display: block; height: 100%; min-width: 6px; background: linear-gradient(90deg, var(--cyan), #a5f3fc); border-radius: inherit; }
  .progress p { margin-top: 6px; font-size: 0.88rem; }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 18px; border-left: 3px solid #bfdbfe; display: flex; flex-direction: column; gap: 16px; }
  .timeline li { position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -27px; top: 26px; width: 15px; height: 15px; border-radius: 50%; background: #fff; border: 4px solid var(--blue); }
  .log { display: flex !important; gap: 16px; align-items: flex-start; }
  .day { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 68px; height: 68px; border-radius: 16px; background: linear-gradient(135deg, var(--blue), var(--cyan)); color: #fff; font-size: 0.72rem; line-height: 1.1; font-weight: 700; }
  .day strong { font-size: 1.6rem; font-family: var(--font-round); }
  time { font-size: 0.8rem; color: var(--muted); margin-right: 8px; }
  h2 { margin: 4px 0; font-size: 1.1rem; }
  p { margin: 0 0 4px; color: #475569; font-size: 0.9rem; }
  small { color: var(--muted); }
  @media (max-width: 520px) { .day { width: 54px; height: 54px; } .day strong { font-size: 1.3rem; } }
</style>
