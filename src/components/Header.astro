---
import { HEADER_NAV, SITE_MENU } from '../data/categories';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (path: string) => (path === '/' ? current === '/' : current.startsWith(path));
const extra = SITE_MENU.filter((m) => !HEADER_NAV.some((n) => n.path === m.path));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={url('/')}>
      <span class="logo-mark" aria-hidden="true">🎓</span>
      <span>AI学習サイト</span>
    </a>
    <nav class="nav" id="site-nav" aria-label="メインメニュー">
      <ul>
        {HEADER_NAV.map((item) => (
          <li><a href={url(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{item.title}</a></li>
        ))}
      </ul>
      <div class="nav-extra">
        <p>そのほかのメニュー</p>
        <ul>
          {extra.map((m) => <li><a href={url(m.path)}>{m.icon} {m.title}</a></li>)}
        </ul>
      </div>
    </nav>
    <div class="header-actions">
      <a class="icon-btn" href={url('/search/')} aria-label="サイト内検索">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <button class="icon-btn menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="メニューを開く">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    nav?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--navy);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }
  .header-inner { display: flex; align-items: center; gap: 16px; height: 64px; }
  .logo { display: flex; align-items: center; gap: 8px; color: #fff; font-family: var(--font-round); font-weight: 800; font-size: 1.15rem; white-space: nowrap; }
  .logo:hover { text-decoration: none; }
  .logo-mark { font-size: 1.4rem; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: 8px 10px; color: #dbe4ff; font-size: 0.88rem; font-weight: 500; border-radius: 8px; white-space: nowrap; }
  .nav a:hover { background: rgba(255, 255, 255, 0.08); text-decoration: none; color: #fff; }
  .nav a[aria-current='page'] { color: var(--cyan); box-shadow: inset 0 -2px 0 var(--cyan); border-radius: 0; }
  .nav-extra { display: none; }
  .header-actions { display: flex; align-items: center; gap: 6px; }
  .icon-btn { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; color: #fff; background: transparent; border: 0; cursor: pointer; }
  .icon-btn:hover { background: rgba(255, 255, 255, 0.1); }
  .menu-btn { display: none; flex-direction: column; gap: 5px; }
  .menu-btn span { display: block; width: 20px; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .menu-btn[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1080px) {
    .header-actions { margin-left: auto; }
    .menu-btn { display: flex; }
    .nav {
      display: none; position: fixed; inset: 64px 0 0 0; background: var(--navy);
      overflow-y: auto; padding: 12px 16px 40px;
    }
    .nav.open { display: block; }
    .nav ul { flex-direction: column; gap: 0; }
    .nav a { padding: 14px 8px; font-size: 1rem; border-bottom: 1px solid rgba(148, 163, 184, 0.15); border-radius: 0; }
    .nav a[aria-current='page'] { box-shadow: none; }
    .nav-extra { display: block; margin-top: 20px; }
    .nav-extra p { color: #94a3b8; font-size: 0.8rem; margin: 0 0 4px; }
  }
  :global(body.menu-open) { overflow: hidden; }
</style>
