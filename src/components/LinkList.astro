---
// 関連記事・逆リンクなどの小さなリスト
import type { LinkItem } from '../lib/content';
import { KIND_LABEL } from '../lib/content';
import { url } from '../lib/url';
interface Props { title: string; items: LinkItem[] }
const { title, items } = Astro.props;
---
{items.length > 0 && (
  <section class="card aside-box link-list">
    <h2>{title}</h2>
    <ul>
      {items.map((i) => (
        <li><a href={url(i.href)}><span class="kind">{KIND_LABEL[i.kind]}</span>{i.kind === 'learning' || i.kind === 'experiments' ? `${i.badge} ` : ''}{i.title}</a></li>
      ))}
    </ul>
  </section>
)}
<style>
  .link-list ul { list-style: none; padding: 0 !important; display: flex; flex-direction: column; gap: 8px; }
  .link-list a { display: block; color: var(--text); line-height: 1.5; }
  .link-list a:hover { color: var(--blue); }
  .kind { display: block; font-size: 0.7rem; color: var(--muted); }
</style>
