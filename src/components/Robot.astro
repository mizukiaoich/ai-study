---
// ヒーローエリアのロボットのイラスト（SVG）。外部画像を使わないので軽く、差し替えも簡単です。
interface Props { size?: number; class?: string }
const { size = 260, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 240 240" role="img" aria-label="一緒に学ぶロボットのイラスト">
  <defs>
    <linearGradient id="rb-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#cfe3ff" />
    </linearGradient>
    <linearGradient id="rb-face" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b1b3f" /><stop offset="1" stop-color="#1e3a8a" />
    </linearGradient>
    <radialGradient id="rb-glow"><stop offset="0" stop-color="#22d3ee" stop-opacity=".55" /><stop offset="1" stop-color="#22d3ee" stop-opacity="0" /></radialGradient>
  </defs>
  <circle cx="120" cy="125" r="112" fill="url(#rb-glow)" />
  <!-- アンテナ -->
  <line x1="120" y1="38" x2="120" y2="58" stroke="#93c5fd" stroke-width="5" stroke-linecap="round" />
  <circle cx="120" cy="32" r="9" fill="#22d3ee" />
  <!-- 頭 -->
  <rect x="58" y="56" width="124" height="96" rx="42" fill="url(#rb-body)" />
  <rect x="48" y="88" width="14" height="32" rx="7" fill="#60a5fa" />
  <rect x="178" y="88" width="14" height="32" rx="7" fill="#60a5fa" />
  <rect x="72" y="72" width="96" height="64" rx="30" fill="url(#rb-face)" />
  <ellipse cx="101" cy="101" rx="9" ry="11" fill="#22d3ee" />
  <ellipse cx="139" cy="101" rx="9" ry="11" fill="#22d3ee" />
  <path d="M106 119 q14 10 28 0" stroke="#22d3ee" stroke-width="5" fill="none" stroke-linecap="round" />
  <!-- 体 -->
  <rect x="82" y="156" width="76" height="56" rx="26" fill="url(#rb-body)" />
  <circle cx="120" cy="182" r="10" fill="#3b82f6" opacity=".85" />
  <!-- 手（手を振っている） -->
  <path d="M84 170 q-26 4 -34 -22" stroke="#bfdbfe" stroke-width="14" fill="none" stroke-linecap="round" />
  <circle cx="48" cy="144" r="11" fill="#ffffff" />
  <path d="M156 170 q22 10 26 30" stroke="#bfdbfe" stroke-width="14" fill="none" stroke-linecap="round" />
  <!-- きらきら -->
  <path d="M200 50 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4z" fill="#a5f3fc" />
  <path d="M30 70 l3 7 7 3 -7 3 -3 7 -3 -7 -7 -3 7 -3z" fill="#c4b5fd" />
</svg>
